{
	"name": "evc-team-relay",
	"version": "1.1.11",
	"description": "Enterprise collaboration with self-hosted relay infrastructure for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs watch",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs develop",
		"release": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"beta": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs debug",
		"staging": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs staging",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"lint": "npx eslint src/"
	},
	"keywords": [
		"obsidian",
		"collaboration",
		"relay",
		"real-time",
		"enterprise"
	],
	"author": "EVC Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/entire-vc/evc-team-relay-obsidian-plugin.git"
	},
	"bugs": {
		"url": "https://github.com/entire-vc/evc-team-relay-obsidian-plugin/issues"
	},
	"homepage": "https://github.com/entire-vc/evc-team-relay-obsidian-plugin#readme",
