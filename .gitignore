# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

*.js
!src/storage/y-indexeddb.js
!__tests__/jest.setup.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store
vaults/

# IDE & Tools (not for OSS)
.cursor/
.claude/
CLAUDE.md

# Internal documentation (not for OSS)
dev-docs/
.cache/

# The end to ends drive Obsidian by evaluating an expression inside it, so
# their payloads are .js and the *.js rule above swallowed them. That rule is
# there for the build output, not for source.
!scripts/e2e/*.js
